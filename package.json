{
  "name": "alethic",
  "version": "0.0.0",
  "description": "Verifiable context for coding agents.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/shubhambaid/alethic.git"
  },
  "bin": {
    "alethic": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3.7.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "^22.20.2",
    "@types/picomatch": "^4.0.3",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0",
    "zod": "4.6.4"
  }
}
